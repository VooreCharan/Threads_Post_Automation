GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-flash-lite-latest

THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# Protects POST /api/trigger (generate a long random string)
TRIGGER_SECRET=

# Telegram control: token from @BotFather; owner id = your numeric Telegram user id
# (message your bot once without TELEGRAM_OWNER_ID set and it will reply with your id)
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=

# Optional
POST_GAP_MIN_SECONDS=30
POST_GAP_MAX_SECONDS=60
THREADS_DAILY_LIMIT=240
NOTIFY_EVERY=1
AUTO_START=false
CATEGORIES=
MAX_AGE_HOURS=48
DRY_RUN=false
DB_PATH=bot.db

# Backup AI providers (free keys). Leave blank to skip a provider. Order is set by LLM_CHAIN.
LLM_CHAIN=groq,nvidia,gemini,openrouter,huggingface,github
GROQ_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
HF_TOKEN=
GITHUB_MODELS_TOKEN=
# Optional per-provider model lists (comma separated): GROQ_MODELS, NVIDIA_MODELS, OPENROUTER_MODELS, HF_MODELS, GITHUB_MODELS

# Images: auto (article image, else a relevant stock photo, else text) | article | stock | off
IMAGE_MODE=auto
IMAGE_MIN_WIDTH=600

# Free stock-photo keys (used when an article has no image of its own); leave blank to skip
PEXELS_API_KEY=
PIXABAY_API_KEY=
UNSPLASH_ACCESS_KEY=

# Post only stories that are mainly about India
INDIA_ONLY=true
