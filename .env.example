GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-flash-lite-latest

THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# Telegram control: token from @BotFather; owner id = your numeric Telegram user id
# (message your bot once without TELEGRAM_OWNER_ID set and it will reply with your id)
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=

# Optional
# Safety limits (a new account starts slower still: 3/day for 3 days, 5/day until day 7)
DAILY_POST_LIMIT=10
MIN_SECONDS_BETWEEN_POSTS=300
ACCOUNT_WARMUP=true
# Nothing is posted until you tap the button in Telegram
REQUIRE_APPROVAL=true
DRAFT_TTL_MINUTES=60
MAX_PENDING_DRAFTS=3
# Skip stories about violence, deaths and tragedies
SKIP_SENSITIVE=true
# Article text: how much the AI reads, and the least a story needs
ARTICLE_CHARS=4500
MIN_ARTICLE_CHARS=250
CATEGORIES=
MAX_AGE_HOURS=48
DRY_RUN=false
DB_PATH=bot.db

# Backup AI providers (free keys). Leave blank to skip a provider. Order is set by LLM_CHAIN.
LLM_CHAIN=groq,nvidia,gemini,openrouter,huggingface,github
GROQ_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
HF_TOKEN=
GITHUB_MODELS_TOKEN=
# Optional per-provider model lists (comma separated): GROQ_MODELS, NVIDIA_MODELS, OPENROUTER_MODELS, HF_MODELS, GITHUB_MODELS

# Images: auto (article's own image first, credited to the publisher; else a relevant stock photo; else text) |
# stock (licensed stock photos only: safest for copyright) | article | off
IMAGE_MODE=auto
IMAGE_MIN_WIDTH=600

# Free stock-photo keys; leave blank to skip
PEXELS_API_KEY=
PIXABAY_API_KEY=
UNSPLASH_ACCESS_KEY=

# Post only stories that are mainly about India
INDIA_ONLY=true

# Optional: Turso database for hosts without a persistent disk (Render free). Leave blank to use bot.db
TURSO_URL=
TURSO_TOKEN=

# Background upkeep: pre-read the top stories, renew the Threads token, check the database (no AI quota used)
PREWARM=true
MAINTENANCE_MINUTES=12
# Send "Bot started" to Telegram on every start
ALERT_ON_START=true

# Telegram: polling (default; host must stay awake) or webhook (Telegram calls the app; a sleeping free host
# wakes on your message). Webhook mode needs PUBLIC_URL; Render provides RENDER_EXTERNAL_URL automatically.
TELEGRAM_MODE=polling
PUBLIC_URL=
TELEGRAM_WEBHOOK_SECRET=
